{
  "name": "@hyperstruck/core",
  "version": "0.12.0",
  "description": "Run-scoped middleware for Hyperstruck: recall in, episode out, receipt proven, from any TypeScript runtime.",
  "author": "Hyperstruck",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "contracts/**/*.json",
    "dist/**/*"
  ],
  "keywords": [
    "hyperstruck",
    "agent-memory",
    "ai-sdk",
    "middleware"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "schema": "openapi-typescript ../openapi.json -o src/schema.ts",
    "test": "node --test 'src/**/*_test.ts'",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "p-queue": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "openapi-typescript": "^7.5.0",
    "typescript": "^5.7.0"
  }
}
