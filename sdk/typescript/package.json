{
  "name": "@hyperstruck/sdk",
  "version": "0.1.0",
  "description": "TypeScript client SDK for the Hyperstruck Core API",
  "author": "Hyperstruck",
  "keywords": [
    "hyperstruck",
    "sdk",
    "api-client",
    "typescript",
    "fetch"
  ],
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --outDir dist/",
    "test": "npm run test:boundary-types",
    "test:boundary-types": "tsc --noEmit --target es5 --module commonjs --lib es6,dom --skipLibCheck custom.d.ts boundary_wire_contract.spec.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "isomorphic-fetch": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "README.md",
    "api.ts",
    "configuration.ts",
    "custom.d.ts",
    "index.ts",
    "dist/**/*"
  ]
}
